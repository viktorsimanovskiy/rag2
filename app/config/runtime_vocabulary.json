{
  "version": "step51b_runtime_vocabulary_v1",
  "purpose": "Общий словарь живого языка для service_resolver. Здесь хранятся разговорные сокращения и бытовые формулировки, которые одинаково полезны для разных услуг. Конкретные алиасы конкретной услуги нужно править в Актуальный_приказ5.xlsx, колонка \"Ключевые слова / алиасы\".",
  "how_to_edit": [
    "Добавляй сюда только общие слова и выражения: коммуналка, садик, маткапитал, ТЖС, ЧС, зубные протезы и т.п.",
    "Не добавляй сюда алиасы только одной конкретной услуги, если они не являются общими разговорными словами.",
    "patterns — регулярные выражения Python; expansion — текст, который будет добавлен вместо найденной бытовой формулировки перед токенизацией.",
    "После изменения файла достаточно перезапустить rag2-api: systemctl restart rag2-api.",
    "Если меняешь алиасы в Актуальный_приказ5.xlsx, нужен повторный импорт service_registry и затем перезапуск API."
  ],
  "phrase_expansions": [
    {
      "id": "jku",
      "patterns": [
        "\\bжкх\\b",
        "\\bжку\\b",
        "\\bкоммуналк[аеиуой]*\\b",
        "\\bквартплат[аеиуой]*\\b"
      ],
      "expansion": "жилищно коммунальные услуги оплата жилого помещения коммунальные услуги",
      "comment": "Коммуналка, квартплата, ЖКХ/ЖКУ."
    },
    {
      "id": "matkapital",
      "patterns": [
        "\\bматкапитал[а-я]*\\b",
        "\\bмат\\s*капитал[а-я]*\\b"
      ],
      "expansion": "материнский семейный капитал",
      "comment": "Разговорное сокращение материнского/семейного капитала."
    },
    {
      "id": "child_garden",
      "patterns": [
        "\\bсадик[а-я]*\\b",
        "\\bдетсад[а-я]*\\b",
        "\\bмест[ао]?\\s+в\\s+сад[а-я]*\\b"
      ],
      "expansion": "детский сад дошкольная образовательная организация место в детском саду",
      "comment": "Детский сад и отсутствие места в нём."
    },
    {
      "id": "driving_school",
      "patterns": [
        "\\bавтошкол[аеиуой]*\\b",
        "\\bучени[ея]\\s+вождени[яю]\\b",
        "\\bна\\s+права\\b"
      ],
      "expansion": "обучение вождению автошкола",
      "comment": "Компенсация обучения вождению."
    },
    {
      "id": "burial",
      "patterns": [
        "\\bпохорон[а-я]*\\b",
        "\\bпохороны\\b",
        "\\bпогребени[а-я]*\\b"
      ],
      "expansion": "погребение похороны",
      "comment": "Погребение / похороны."
    },
    {
      "id": "grave_improvement",
      "patterns": [
        "\\bпамятник[а-я]*\\b",
        "\\bмогил[а-я]*\\b",
        "\\bзахоронени[а-я]*\\b"
      ],
      "expansion": "памятник благоустройство могил захоронение",
      "comment": "Памятник, могила, благоустройство захоронения."
    },
    {
      "id": "dental_prosthetics",
      "patterns": [
        "\\bзубн[а-я]*\\s+протез[а-я]*\\b",
        "\\bзубопротез[а-я]*\\b",
        "\\b(?:делать|сделать|вставить|поставить)\\s+зуб[а-я]*\\b",
        "\\bлечить\\s+зуб[а-я]*\\b",
        "\\bпротез[а-я]*\\s+зуб[а-я]*\\b"
      ],
      "expansion": "зубопротезирование стоматологические протезы зубные протезы",
      "comment": "Зубные протезы, сделать/поставить зубы."
    },
    {
      "id": "stove_heating",
      "patterns": [
        "\\bпечк[аеиуой]*\\b",
        "\\bпроводк[аеиуой]*\\b",
        "\\bтопить\\b",
        "\\bтоплени[ея]\\b",
        "\\bдров[а-я]*\\b"
      ],
      "expansion": "печное отопление электропроводка дрова топливо материальная помощь",
      "comment": "Печка, дрова, печное отопление, электропроводка."
    },
    {
      "id": "social_worker",
      "patterns": [
        "\\bсоцработник[а-я]*\\b",
        "\\bсоцобслуживани[а-я]*\\b",
        "\\bпомощ[ьи]\\s+по\\s+дому\\b"
      ],
      "expansion": "социальное обслуживание социальный работник уход помощь на дому",
      "comment": "Социальное обслуживание и помощь соцработника."
    },
    {
      "id": "emergency",
      "patterns": [
        "\\bчс\\b",
        "\\bпожар[а-я]*\\b",
        "\\bсгорел[а-я]*\\b",
        "\\bзатопил[а-я]*\\b",
        "\\bпотоп[а-я]*\\b",
        "\\bимущество\\s+утрач[а-я]*\\b"
      ],
      "expansion": "чрезвычайная ситуация пожар утрата имущества материальная помощь",
      "comment": "ЧС, пожар, затопление, утрата имущества."
    },
    {
      "id": "tjs",
      "patterns": [
        "\\bтжс\\b",
        "\\bтрудн[а-я]*\\s+жизненн[а-я]*\\s+ситуац[а-я]*\\b",
        "\\bнечего\\s+есть\\b",
        "\\bнет\\s+денег\\s+на\\s+продукт[а-я]*\\b",
        "\\bсломал[а-я]*\\s+холодильник[а-я]*\\b"
      ],
      "expansion": "трудная жизненная ситуация материальная помощь адресная помощь продукты первая необходимость",
      "comment": "ТЖС и бытовые кризисные формулировки."
    },
    {
      "id": "rehab_devices",
      "patterns": [
        "\\bтср\\b",
        "\\bколяск[а-я]*\\b",
        "\\bсредств[ао]?\\s+реабилитаци[а-я]*\\b"
      ],
      "expansion": "технические средства реабилитации средство реабилитации",
      "comment": "ТСР и средства реабилитации."
    },
    {
      "id": "chernobyl",
      "patterns": [
        "\\bчаэс\\b",
        "\\bчернобыл[а-я]*\\b"
      ],
      "expansion": "чернобыльская аэс чернобылец радиационное воздействие",
      "comment": "Чернобыль, ЧАЭС."
    },
    {
      "id": "camp",
      "patterns": [
        "\\bлагер[ьяеюям]*\\b",
        "\\bпутевк[а-я]*\\s+в\\s+лагер[а-я]*\\b"
      ],
      "expansion": "оздоровительный лагерь путевка в лагерь отдых детей",
      "comment": "Детский лагерь."
    },
    {
      "id": "hemodialysis",
      "patterns": [
        "\\bгемодиализ[а-я]*\\b",
        "\\bдиализ[а-я]*\\b"
      ],
      "expansion": "гемодиализ диализ проезд к месту получения медицинской помощи",
      "comment": "Гемодиализ / диализ."
    },
    {
      "id": "donor",
      "patterns": [
        "\\bдонор[а-я]*\\b",
        "\\bдонорск[а-я]*\\s+выплат[а-я]*\\b"
      ],
      "expansion": "донор почетный донор донорская выплата донорские выплаты",
      "comment": "Донор, донорам, донорские выплаты. Конкретные донорские алиасы лучше также добавить в Excel к нужным услугам."
    }
  ]
}
